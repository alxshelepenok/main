<!DOCTYPE html>
<html lang="{{ lang }}" id="web">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="robots" content="{{ robots | default(value="index, follow") }}">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="language" content="English">
    <title>{% block title %}{{ title }}{% endblock title %}</title>
    <meta name="description" content="{{ description }}">
    <meta name="author" content="{{ name }}">
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96">
    <link rel="icon" type="image/svg+xml" href="/logo.svg">
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/alxshelepenok.webmanifest">
    <link rel="canonical" href="{{ canonical }}">
    {% if markdown_source %}<link rel="alternate" type="text/markdown" href="{{ markdown_source }}" title="{{ article_title }} - Markdown source">{% endif %}
    {% if show_feed %}<link rel="alternate" type="application/atom+xml" title="{{ name }} blog" href="/atom.xml">{% endif %}
    <meta property="og:type" content="{{ og_type | default(value="website") }}">
    <meta property="og:site_name" content="{{ name }}">
    <meta property="og:locale" content="{{ og_locale }}">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:url" content="{{ canonical }}">
    {% if og_image %}
    <meta property="og:image" content="{{ og_image }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{ description }}">
    {% endif %}
    {% if article_published %}<meta property="article:published_time" content="{{ article_published }}">{% endif %}
    {% if article_publisher %}<meta property="article:publisher" content="{{ article_publisher }}">{% endif %}
    {% for tag in article_tags_readable | default(value=[]) %}<meta property="article:tag" content="{{ tag }}">{% endfor %}
    <meta name="twitter:card" content="{% if og_image %}summary_large_image{% else %}summary{% endif %}">
    <meta name="twitter:title" content="{{ title }}">
    <meta name="twitter:description" content="{{ description }}">
    {% if og_image %}<meta name="twitter:image" content="{{ og_image }}">{% endif %}
    {% if json_ld %}<script type="application/ld+json">{{ json_ld | safe }}</script>{% endif %}
    <style>{{ style }}</style>
    {% block head %}{% endblock head %}
  </head>
  <body>
    <a class="skip-link" href="#page">Skip to main content</a>
    {% block content %}{% endblock content %}
    <footer class="footer">
      <nav aria-label="Footer menu">
        {% if footer_home %}
        {% if footer_tags %}
        <ul class="footer-links">
          {%- for tag in footer_tags %}
          <li><a href="{{ tag.href }}" rel="tag">{{ tag.name }}</a></li>
          {% endfor -%}
        </ul>
        {% endif %}
        <ul class="footer-links">
          <li><a href="/llms.txt">llms.txt</a></li>
          <li><a href="/llms-full.txt">llms-full.txt</a></li>
        </ul>
        {% else %}
        <ul class="footer-links">
          {%- for link in footer_links | default(value=[]) %}
          <li><a target="_blank" rel="noopener noreferrer" href="{{ link.href }}">{{ link.title | spaceless }}</a></li>
          {% endfor -%}
        </ul>
        <ul class="footer-links">
          <li><a href="{{ home_href }}">Back to home</a></li>
          <li><a href="/llms.txt">llms.txt</a></li>
          <li><a href="/llms-full.txt">llms-full.txt</a></li>
        </ul>
        {% endif %}
      </nav>
    </footer>
    {% if audit %}<script>window.__SITE_AUDIT__=true;window.__SITE_AUDIT_URL__="{{ site_url }}";</script><script src="/audit/schema-audit.js"></script><script src="/audit/accessibility-tree-audit.js"></script>{% endif %}
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ gtag }}"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      };
      gtag("js", new Date());
      gtag("config", "{{ gtag }}");
    </script>
  </body>
</html>
