{% extends "base.hbs" %}


{% block content %}
<header class="header"><a href="{{ home_href }}">{{ name }}</a></header>
<main id="page" tabindex="-1">
  <section class="listing" aria-labelledby="tags-title">
    <header class="listing-header">
      <nav class="breadcrumbs" id="breadcrumb" aria-label="Breadcrumb" tabindex="-1">
        <ol>
          <li><a href="{{ home_href }}">{{ labels.home }}</a></li>
          <li><a href="{{ blog_href }}">{{ labels.blog }}</a></li>
          <li aria-current="page">{{ labels.tags }}</li>
        </ol>
      </nav>
      <hgroup>
        <h1 id="tags-title">{{ labels.tags }}</h1>
        <p>Every collection on this blog.</p>
      </hgroup>
    </header>
    <ul id="tags" aria-label="{{ labels.tags }}">
      {%- for tag in tags %}
      <li class="tag-chip">
        <a href="{{ tag.href }}" rel="tag">{{ tag.name }}</a>
        <span class="tag-count">{{ tag.count }}</span>
      </li>
      {% endfor -%}
    </ul>
  </section>
</main>
{% endblock content %}
