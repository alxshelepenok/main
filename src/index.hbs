{% extends "base.hbs" %}

{% block content %}
<main id="page" tabindex="-1">
  <section class="content" id="person" aria-labelledby="person-title">
    <hgroup>
      <h1 id="person-title">{{ name }}</h1>
      <p>{{ note }}</p>
    </hgroup>
    {% if recent_articles %}
    <section class="links" id="blog" aria-labelledby="blog-title">
      <h2 id="blog-title">{{ labels.recent }}</h2>
      <ul id="blog-articles" aria-labelledby="blog-title">
        {%- for article in recent_articles %}
        <li id="article-{{ article.slug }}" class="with-time">
          <a href="{{ article.href }}">{{ article.title }}</a>
          <time datetime="{{ article.date_iso }}">{{ article.date }}</time>
        </li>
        {% endfor -%}
      </ul>
      <a href="{{ blog_href }}">All articles</a>
    </section>
    {% endif %}
    <section class="links" id="links" aria-labelledby="links-title">
      <h2 id="links-title">{{ labels.links }}</h2>
      <ul id="links-list" aria-labelledby="links-title">
        {%- for link in links %}
        <li><a target="_blank" rel="noopener noreferrer" href="{{ link.href }}" id="link-{{ link.title | slugify }}">{{ link.title | spaceless }}</a></li>
        {% endfor -%}
      </ul>
    </section>
  </section>
</main>
{% endblock content %}
